<Project Sdk="Microsoft.NET.Sdk">
    <!-- Reads the black box the simulator writes to physicslog/*.blackbox. Only the
         base library: the starter, the viewer and any other program can use it, and
         it goes through NativeAOT and trimming as they do. -->
    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <Nullable>enable</Nullable>
        <IsAotCompatible>true</IsAotCompatible>
        <IsTrimmable>true</IsTrimmable>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
        <RootNamespace>Eu07.BlackBox</RootNamespace>
    </PropertyGroup>
</Project>
