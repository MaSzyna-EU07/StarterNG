<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:starterNg="clr-namespace:StarterNG"
             xmlns:ctl="clr-namespace:StarterNG.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="StarterNG.Views.Settings"
             x:CompileBindings="True">
    <DockPanel>

        <!-- Action bar: where the file lives, whether anything is unsaved, and the
             two operations on the whole file. -->
        <Border DockPanel.Dock="Bottom" Padding="16,10" Background="{StaticResource CarbonPanelBg}"
                BorderBrush="{StaticResource CarbonBorderLight}" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <!-- A dock rather than a stack, so a long path is cut short instead of running under the buttons. -->
                <DockPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Opacity="0.6" FontSize="12" Margin="0,0,6,0"
                               Text="{Binding [SettingsPath], Source={x:Static starterNg:App.Loc}}" />
                    <TextBlock x:Name="SettingsPathText" VerticalAlignment="Center" Opacity="0.8" FontSize="12"
                               TextTrimming="LeadingCharacterEllipsis" />
                </DockPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
                    <TextBlock x:Name="SaveStatus" VerticalAlignment="Center" Opacity="0.8" Text="" />
                    <Button x:Name="ChangesButton" Classes="Flat" Click="ChangesButton_OnClick"
                            Content="{Binding [IniChangesButton], Source={x:Static starterNg:App.Loc}}" />
                    <Button x:Name="ResetButton" Classes="Flat" Click="ResetButton_OnClick"
                            Content="{Binding [Reset], Source={x:Static starterNg:App.Loc}}" />
                    <Button x:Name="SaveButton" Classes="Flat" Click="SaveButton_OnClick"
                            Content="{Binding [Save], Source={x:Static starterNg:App.Loc}}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid ColumnDefinitions="180,*">

            <!-- Category sidebar: search on top, categories in the middle, the
                 settings-file profile (an operation on all of them) at the bottom. -->
            <Border Grid.Column="0" Background="{StaticResource CarbonPanelBg}"
                    BorderBrush="{StaticResource CarbonBorderLight}" BorderThickness="0,0,1,0">
                <DockPanel Margin="8,10,8,10">
                    <TextBox x:Name="SettingsSearch" DockPanel.Dock="Top" Margin="0,0,0,10"
                             PlaceholderText="{Binding [Search], Source={x:Static starterNg:App.Loc}}"
                             TextChanged="SettingsSearch_OnTextChanged" />

                    <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,14,0,0">
                        <TextBlock Classes="FieldLabel"
                                   Text="{Binding [SettingsProfile], Source={x:Static starterNg:App.Loc}}" />
                        <ComboBox x:Name="ProfileCb" HorizontalAlignment="Stretch" />
                        <Button x:Name="ProfileApplyBtn" Classes="Flat" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Content="{Binding [ProfileApply], Source={x:Static starterNg:App.Loc}}"
                                Click="ProfileApplyButton_OnClick" />
                        <Button x:Name="ProfileSaveAsBtn" Classes="Flat" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Content="{Binding [ProfileSaveAs], Source={x:Static starterNg:App.Loc}}"
                                Click="ProfileSaveAsButton_OnClick" />
                        <TextBlock Classes="FieldLabel" Margin="0,8,0,0"
                                   Text="{Binding [SettingsFile], Source={x:Static starterNg:App.Loc}}" />
                        <Button x:Name="ImportIniBtn" Classes="Flat" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Content="{Binding [ImportIni], Source={x:Static starterNg:App.Loc}}"
                                Click="ImportIniButton_OnClick" />
                        <Button x:Name="ExportIniBtn" Classes="Flat" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Content="{Binding [ExportIni], Source={x:Static starterNg:App.Loc}}"
                                Click="ExportIniButton_OnClick" />
                    </StackPanel>

                    <ListBox x:Name="CategoryList" Classes="SettingsNav" SelectedIndex="0"
                             ItemContainerTheme="{StaticResource SettingsNavItem}"
                             SelectionChanged="CategoryList_OnSelectionChanged">
                        <ListBoxItem Tag="general" Content="{Binding [General], Source={x:Static starterNg:App.Loc}}" />
                        <ListBoxItem Tag="graphics" Content="{Binding [Graphic], Source={x:Static starterNg:App.Loc}}" />
                        <ListBoxItem Tag="effects" Content="{Binding [Effects], Source={x:Static starterNg:App.Loc}}" />
                        <ListBoxItem Tag="sound" Content="{Binding [Sounds], Source={x:Static starterNg:App.Loc}}" />
                        <ListBoxItem Tag="physics" Content="{Binding [Physics], Source={x:Static starterNg:App.Loc}}" />
                        <ListBoxItem Tag="devices" Content="{Binding [Communication], Source={x:Static starterNg:App.Loc}}" />
                        <ListBoxItem Tag="controls" Content="{Binding [Controls], Source={x:Static starterNg:App.Loc}}" />
                        <ListBoxItem Tag="advanced" Content="{Binding [Advanced], Source={x:Static starterNg:App.Loc}}" />
                    </ListBox>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1" RowDefinitions="Auto,*">
                <!-- A level of detail in one go; stays in sight while the rows below follow it. -->
                <Border x:Name="PresetBar" IsVisible="False" Padding="20,8"
                        Background="{StaticResource CarbonPanelBg}"
                        BorderBrush="{StaticResource CarbonBorderLight}" BorderThickness="0,0,0,1">
                    <StackPanel Spacing="4" MaxWidth="880">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <TextBlock VerticalAlignment="Center" FontWeight="Bold"
                                       Text="{Binding [GfxColPresets], Source={x:Static starterNg:App.Loc}}" />
                            <StackPanel x:Name="PresetButtons" Grid.Column="1" Orientation="Horizontal" Spacing="6" />
                            <TextBlock x:Name="PresetStateText" Grid.Column="2" VerticalAlignment="Center" FontSize="12"
                                       Foreground="{StaticResource CarbonFgDim}" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <TextBlock x:Name="CardText" IsVisible="False" MaxWidth="320" VerticalAlignment="Center"
                                       FontSize="12" TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource CarbonFg}" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap"
                                       TextAlignment="Right" Foreground="{StaticResource CarbonFgDim}"
                                       Text="{Binding [GfxPresetDesc], Source={x:Static starterNg:App.Loc}}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Panel Grid.Row="1">
                <ScrollViewer x:Name="SettingsScroll"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="SettingsStack" Margin="20,18,20,18" MaxWidth="880">

                        <!-- ============================ GENERAL ============================ -->
                        <StackPanel Tag="general">
                            <TextBlock Classes="CategoryCaption" IsVisible="False"
                                       Text="{Binding [General], Source={x:Static starterNg:App.Loc}}" />
                            <ctl:SettingsSection Header="{Binding [General], Source={x:Static starterNg:App.Loc}}">
                                <StackPanel>
                                    <ctl:SettingRow ConfigKey="starter.exe.path" Label="{Binding [SelectEXE], Source={x:Static starterNg:App.Loc}}">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                            <ComboBox x:Name="SelectExeCb" Classes="Localized" SelectedIndex="0" HorizontalAlignment="Stretch" />
                                            <Button x:Name="BrowseExeButton" Grid.Column="1" Classes="Flat" Cursor="Hand"
                                                    Click="BrowseExeButton_OnClick"
                                                    Content="{Binding [SelectEXEBrowse], Source={x:Static starterNg:App.Loc}}" />
                                        </Grid>
                                    </ctl:SettingRow>
                                    <ctl:SettingRow ConfigKey="lang" x:Name="LanguageRow" Label="{Binding [Language], Source={x:Static starterNg:App.Loc}}">
                                        <ComboBox x:Name="ChangeLanguageCb"
                                                  SelectionChanged="LanguageComboBox_OnSelectionChanged" />
                                    </ctl:SettingRow>
                                    <ctl:SettingRow ConfigKey="fullscreen">
                                        <CheckBox x:Name="FullscreenCb" Content="{Binding [Fullscreen], Source={x:Static starterNg:App.Loc}}" />
                                    </ctl:SettingRow>
                                    <ctl:SettingRow ConfigKey="inactivepause">
                                        <CheckBox x:Name="PauseInactiveCb" Content="{Binding [PauseSimInactive], Source={x:Static starterNg:App.Loc}}" />
                                    </ctl:SettingRow>
                                    <ctl:SettingRow ConfigKey="pause">
                                        <CheckBox x:Name="PauseStartCb" Content="{Binding [PauseSimStart], Source={x:Static starterNg:App.Loc}}" />
                                    </ctl:SettingRow>
                                    <ctl:SettingRow ConfigKey="mousescale" x:Name="CursorSensitivityRow"
                                                    Label="{Binding [CursorSensitivity], Source={x:Static starterNg:App.Loc}}">
                                        <Slider x:Name="CursorSensitivitySlider" Minimum="1" Maximum="5" TickFrequency="1"
                                                IsSnapToTickEnabled="True" Value="3"
                                                ValueChanged="QualitySlider_OnValueChanged" />
                                    </ctl:SettingRow>
                                    <ctl:SettingRow ConfigKey="mousescale">
                                        <CheckBox x:Name="MouseHorInvertCb" Content="{Binding [MouseHorInvert], Source={x:Static starterNg:App.Loc}}" />
                                    </ctl:SettingRow>
                                    <ctl:SettingRow ConfigKey="mousescale">
                                        <CheckBox x:Name="MouseVertInvertCb" Content="{Binding [MouseVertInvert], Source={x:Static starterNg:App.Loc}}" />
                                    </ctl:SettingRow>
                                </StackPanel>
                            </ctl:SettingsSection>

                            <ctl:SettingsSection Header="{Binding [Starter], Source={x:Static starterNg:App.Loc}}">
                                <StackPanel>
                                    <ctl:SettingRow ConfigKey="starter.autoclose">
                                        <CheckBox x:Name="AutoCloseStarterCb" Content="{Binding [AutoCloseStarter], Source={x:Static starterNg:App.Loc}}" />
                                    </ctl:SettingRow>
                                    <ctl:SettingRow ConfigKey="starter.largethumbnails">
                                        <CheckBox x:Name="LargeThumbnailsCb" Content="{Binding [LargeThumbnails], Source={x:Static starterNg:App.Loc}}" />
                                    </ctl:SettingRow>
                                    <ctl:SettingRow ConfigKey="starter.expandtree">
                                        <CheckBox x:Name="AutoExpandTreeCb" Content="{Binding [AutoExpandSceneryTree], Source={x:Static starterNg:App.Loc}}" />
                                    </ctl:SettingRow>
                                    <ctl:SettingRow ConfigKey="starter.batterydefault"
                                                    Label="{Binding [ReadyOverride], Source={x:Static starterNg:App.Loc}}"
                                                    Description="{Binding [ReadyOverrideDesc], Source={x:Static starterNg:App.Loc}}">
                                        <ComboBox x:Name="ReadyOverrideCb" Classes="Localized" SelectedIndex="0">
                                            <ComboBoxItem Content="{Binding [ReadyOverrideScenery], Source={x:Static starterNg:App.Loc}}" />
                                            <ComboBoxItem Content="{Binding [ReadyOverrideCold], Source={x:Static starterNg:App.Loc}}" />
                                            <ComboBoxItem Content="{Binding [ReadyOverrideReady], Source={x:Static starterNg:App.Loc}}" />
                                        </ComboBox>
                                    </ctl:SettingRow>
                                </StackPanel>
                            </ctl:SettingsSection>

                            <ctl:SettingsSection Header="{Binding [Others], Source={x:Static starterNg:App.Loc}}">
                                <StackPanel>
                                    <ctl:SettingRow Description="{Binding [DebugModeDesc], Source={x:Static starterNg:App.Loc}}" ConfigKey="debugmode">
                                        <CheckBox x:Name="DebugModeCb" Content="{Binding [DebugMode], Source={x:Static starterNg:App.Loc}}" />
                                    </ctl:SettingRow>
                                    <ctl:SettingRow ConfigKey="ai.trainman" Description="{Binding [VirtualShuntingDesc], Source={x:Static starterNg:App.Loc}}">
                                        <CheckBox x:Name="VirtualShuntingCb" Content="{Binding [VirtualShunting], Source={x:Static starterNg:App.Loc}}" />
                                    </ctl:SettingRow>
                                    <ctl:SettingRow ConfigKey="starter.logmissingvehicles" Description="{Binding [LogMissingVehicleFilesDesc], Source={x:Static starterNg:App.Loc}}">
                                        <CheckBox x:Name="LogMissingVehicleFilesCb" Content="{Binding [LogMissingVehicleFiles], Source={x:Static starterNg:App.Loc}}" />
                                    </ctl:SettingRow>
                                </StackPanel>
                            </ctl:SettingsSection>
                        </StackPanel>

                        <!-- ============================ GRAPHICS =========================== -->
                        <StackPanel Tag="graphics" IsVisible="False">
                            <TextBlock Classes="CategoryCaption" IsVisible="False"
                                       Text="{Binding [Graphic], Source={x:Static starterNg:App.Loc}}" />
                            <!-- Which renderer comes first: it decides which of the rows below the simulator reads. -->
                            <ctl:SettingsSection Header="{Binding [GfxColRendering], Source={x:Static starterNg:App.Loc}}">
                                <StackPanel>
                                    <ctl:SettingRow ConfigKey="gfxrenderer" Label="{Binding [RenderEngine], Source={x:Static starterNg:App.Loc}}"
                                                    Description="{Binding [RenderEngineDesc], Source={x:Static starterNg:App.Loc}}">
                                        <StackPanel Spacing="6">
                                            <ComboBox x:Name="RenderEngineCb" Classes="Localized" SelectedIndex="0"
                                                      SelectionChanged="RenderEngineCb_OnSelectionChanged">
                                                <ComboBoxItem Content="{Binding [REFull], Source={x:Static starterNg:App.Loc}}" />
                                                <ComboBoxItem Content="{Binding [REOld], Source={x:Static starterNg:App.Loc}}" />
                                                <ComboBoxItem Content="{Binding [RESimp], Source={x:Static starterNg:App.Loc}}" />
                                                <ComboBoxItem Content="{Binding [REExperimental], Source={x:Static starterNg:App.Loc}}" />
                                                <ComboBoxItem Content="{Binding [REVulkan], Source={x:Static starterNg:App.Loc}}" />
                                            </ComboBox>
                                            <TextBlock x:Name="RenderEngineNote" Classes="SettingNote" IsVisible="False" />
                                            <!-- Amber like the UART warnings: this one stops the simulator. -->
                                            <TextBlock x:Name="RenderEngineWarning" IsVisible="False" TextWrapping="Wrap"
                                                       Foreground="{StaticResource CarbonAccentBright}"
                                                       Text="{Binding [REExperimentalWarning], Source={x:Static starterNg:App.Loc}}" />
                                        </StackPanel>
                                    </ctl:SettingRow>
                                    <ctl:SettingRow x:Name="GpuRow" ConfigKey="starter.gpu" Label="{Binding [GpuChoice], Source={x:Static starterNg:App.Loc}}">
                                        <ComboBox x:Name="GpuCb" Classes="Localized" SelectedIndex="0"
                                                  SelectionChanged="GpuCb_OnSelectionChanged">
                                            <ComboBoxItem Content="{Binding [GpuDiscrete], Source={x:Static starterNg:App.Loc}}" />
                                            <ComboBoxItem Content="{Binding [GpuSystem], Source={x:Static starterNg:App.Loc}}" />
                                        </ComboBox>
                                    </ctl:SettingRow>
                                    <ctl:SettingRow ConfigKey="gfx.angleplatform" Description="{Binding [RenderAngleVulkanDesc], Source={x:Static starterNg:App.Loc}}">
                                        <CheckBox x:Name="RenderAngleVulkanCb" Content="{Binding [RenderAngleVulkan], Source={x:Static starterNg:App.Loc}}" />
                                    </ctl:SettingRow>
                                    <ctl:SettingRow ConfigKey="gfx.extraeffects">
                                        <CheckBox x:Name="AdditionalShadersCb" Content="{Binding [AdditionalShadersEffects], Source={x:Static starterNg:App.Loc}}" />
                                    </ctl:SettingRow>
                                    <ctl:SettingRow ConfigKey="gfx.skippipeline" Description="{Binding [SkipPipelineDesc], Source={x:Static starterNg:App.Loc}}">
                                        <StackPanel Spacing="6">
                                            <CheckBox x:Name="SkipPipelineCb" Content="{Binding [SkipPipeline], Source={x:Static starterNg:App.Loc}}" />
                                            <TextBlock x:Name="SkipPipelineNote" Classes="SettingNote" IsVisible="False" />
                                        </StackPanel>
                                    </ctl:SettingRow>
                                    <ctl:SettingRow ConfigKey="usevbo" Description="{Binding [RenderVBODesc], Source={x:Static starterNg:App.Loc}}">
                                        <CheckBox x:Name="RenderVBOCb" Content="{Binding [RenderVBO], Source={x:Static starterNg:App.Loc}}" />
                                    </ctl:SettingRow>
                                    <ctl:KeySlot Key="skyenabled" />
                                    <ctl:KeySlot Key="rendercab" />
                                    <ctl:KeySlot Key="newaircouplers" />
                                    <ctl:KeySlot Key="smoothtraction" />
                                </StackPanel>
                            </ctl:SettingsSection>

                            <ctl:SettingsSection Header="{Binding [GfxColImage], Source={x:Static starterNg:App.Loc}}">
                                <StackPanel>
                                    <ctl:SettingRow ConfigKey="width, height" Label="{Binding [Resolution], Source={x:Static starterNg:App.Loc}}">
                                        <ComboBox x:Name="ResolutionCb" />
                                    </ctl:SettingRow>
                                    <ctl:SettingRow ConfigKey="fullscreenwindowed">
                                        <CheckBox x:Name="FullscreenWindowedCb" Content="{Binding [FullscreenWindowed], Source={x:Static starterNg:App.Loc}}" />
                                    </ctl:SettingRow>
                                    <ctl:SettingRow x:Name="BufferScaleRow" ConfigKey="gfx.buffer.percent, starter.bufferscale"
                                                    Label="{Binding [BufforResolution], Source={x:Static starterNg:App.Loc}}"
                                                    Description="{Binding [BufforResolutionDesc], Source={x:Static starterNg:App.Loc}}"
                                                    ValueText="{Binding #bufferScale.Value, StringFormat='{}{0:0}%'}">
                                        <Slider Name="bufferScale" Minimum="25" Maximum="200" TickFrequency="1"
                                                IsSnapToTickEnabled="True" Value="100" />
                                    </ctl:SettingRow>
                                    <ctl:SettingRow ConfigKey="fieldofview" Label="{Binding [FieldOfView], Source={x:Static starterNg:App.Loc}}"
                                                    Description="{Binding [FieldOfViewDesc], Source={x:Static starterNg:App.Loc}}"
                                                    ValueText="{Binding #fovSlider.Value, StringFormat='{}{0:0}°'}">
                                        <Slider Name="fovSlider" Minimum="10" Maximum="75" TickFrequency="5"
                                                IsSnapToTickEnabled="True" Value="45" />
                                    </ctl:SettingRow>
                                    <ctl:SettingRow ConfigKey="gfx.antialiasing, multisampling"
                                                    Label="{Binding [AntiAliasing], Source={x:Static starterNg:App.Loc}}"
                                                    Description="{Binding [AntiAliasingDesc], Source={x:Static starterNg:App.Loc}}">
                                        <StackPanel Spacing="6">
                                            <ComboBox x:Name="AntiAliasingCb" Classes="Localized" SelectedIndex="0">
                                                <ComboBoxItem Tag="off" Content="{Binding [MsaaNone], Source={x:Static starterNg:App.Loc}}" />
                                                <ComboBoxItem Tag="msaax2" Content="MSAA x2" />
                                                <ComboBoxItem Tag="msaax4" Content="MSAA x4" />
                                                <ComboBoxItem Tag="msaax8" Content="MSAA x8" />
                                                <ComboBoxItem Tag="taa" Content="{Binding [AaTaa], Source={x:Static starterNg:App.Loc}}" />
                                                <ComboBoxItem Tag="dlss" Content="{Binding [AaDlss], Source={x:Static starterNg:App.Loc}}" />
                                                <ComboBoxItem Tag="dlaa" Content="{Binding [AaDlaa], Source={x:Static starterNg:App.Loc}}" />
                                            </ComboBox>
                                            <TextBlock x:Name="AntiAliasingNote" Classes="SettingNote" IsVisible="False" />
                                        </StackPanel>
                                    </ctl:SettingRow>
                                </StackPanel>
                            </ctl:SettingsSection>

                            <ctl:SettingsSection Header="{Binding [GfxColSmoothness], Source={x:Static starterNg:App.Loc}}">
                                <StackPanel>
                                    <ctl:SettingRow ConfigKey="vsync" Description="{Binding [VSyncDesc], Source={x:Static starterNg:App.Loc}}">
                                        <CheckBox x:Name="VSyncCb" Content="{Binding [VSync], Source={x:Static starterNg:App.Loc}}" />
                                    </ctl:SettingRow>
                                    <ctl:SettingRow ConfigKey="fpslimit" x:Name="FpsLimitRow"
                                                    Label="{Binding [FpsLimit], Source={x:Static starterNg:App.Loc}}"
                                                    Description="{Binding [FpsLimitDesc], Source={x:Static starterNg:App.Loc}}">
                                        <StackPanel Spacing="4">
                                            <!-- Moves through no limit and Steps.FrameRateLimits; see SliderSteps. -->
                                            <Slider x:Name="FpsLimitSlider" ValueChanged="QualitySlider_OnValueChanged" />
                                            <!-- The screens found, each with a button to match the limit to it. -->
                                            <WrapPanel x:Name="MonitorRates" IsVisible="False" />
                                        </StackPanel>
                                    </ctl:SettingRow>
                                </StackPanel>
                            </ctl:SettingsSection>

                            <ctl:SettingsSection x:Name="DrawRangeSection" Header="{Binding [GfxColDrawRange], Source={x:Static starterNg:App.Loc}}">
                                <StackPanel>
                                    <ctl:KeySlot Key="basedrawrange" />
                                    <ctl:KeySlot Key="targetfps" />
                                    <ctl:SettingRow ConfigKey="gfx.drawrange.factor.max" x:Name="RenderRangeRow"
                                                    Label="{Binding [RenderRange], Source={x:Static starterNg:App.Loc}}"
                                                    Description="{Binding [RenderRangeDesc], Source={x:Static starterNg:App.Loc}}">
                                        <!-- Moves through Steps.DrawRangeFactors; see SliderSteps. -->
                                        <Slider x:Name="RenderRangeSlider"
                                                ValueChanged="QualitySlider_OnValueChanged" />
                                    </ctl:SettingRow>
                                    <ctl:KeySlot Key="sleeperdistance" />
                                    <ctl:SettingRow ConfigKey="splinefidelity" x:Name="TrackCurvesRow"
                                                    Label="{Binding [TrackCurvesQuality], Source={x:Static starterNg:App.Loc}}"
                                                    Description="{Binding [TrackCurvesQualityDesc], Source={x:Static starterNg:App.Loc}}">
                                        <Slider x:Name="TrackCurvesSlider" Minimum="1" Maximum="4" TickFrequency="1"
                                                IsSnapToTickEnabled="True" Value="4"
                                                ValueChanged="QualitySlider_OnValueChanged" />
                                    </ctl:SettingRow>
                                </StackPanel>
                            </ctl:SettingsSection>

                            <ctl:SettingsSection x:Name="TexturesSection" Header="{Binding [GfxColTextures], Source={x:Static starterNg:App.Loc}}">
                                <StackPanel>
                                    <ctl:SettingRow ConfigKey="maxtexturesize" x:Name="TexResolutionRow"
                                                    Label="{Binding [MaxTexResolution], Source={x:Static starterNg:App.Loc}}">
                                        <Slider Name="textureResolutionSlider" Minimum="6" Maximum="13" TickFrequency="1"
                                                IsSnapToTickEnabled="True" Value="12"
                                                ValueChanged="TextureResolutionSlider_OnValueChanged" />
                                    </ctl:SettingRow>
                                    <ctl:SettingRow ConfigKey="maxcabtexturesize" x:Name="CabTexResolutionRow"
                                                    Label="{Binding [MaxTexCabResolution], Source={x:Static starterNg:App.Loc}}">
                                        <Slider Name="cabTextureResolutionSlider" Minimum="9" Maximum="13" TickFrequency="1"
                                                IsSnapToTickEnabled="True" Value="12"
                                                ValueChanged="CabTextureResolutionSlider_OnValueChanged" />
                                    </ctl:SettingRow>
                                    <ctl:SettingRow ConfigKey="anisotropicfiltering" x:Name="TexFilteringRow"
                                                    Label="{Binding [TexFilteringQuality], Source={x:Static starterNg:App.Loc}}"
                                                    Description="{Binding [TexFilteringQualityDesc], Source={x:Static starterNg:App.Loc}}">
                                        <!-- Moves through Steps.Anisotropy; see SliderSteps. -->
                                        <Slider x:Name="TexFilteringSlider"
                                                ValueChanged="QualitySlider_OnValueChanged" />
                                    </ctl:SettingRow>
                                    <ctl:KeySlot Key="gfx.textures.streaming" />
                                    <ctl:KeySlot Key="gfx.textures.releasedistance" />
                                </StackPanel>
                            </ctl:SettingsSection>

                            <ctl:SettingsSection Header="{Binding [GfxColScripts], Source={x:Static starterNg:App.Loc}}">
                                <StackPanel>
                                    <ctl:SettingRow ConfigKey="python.enabled" Description="{Binding [RenderScreensDesc], Source={x:Static starterNg:App.Loc}}">
                                        <CheckBox x:Name="RenderScreensCb" Content="{Binding [RenderScreens], Source={x:Static starterNg:App.Loc}}" />
                                    </ctl:SettingRow>
                                    <StackPanel IsEnabled="{Binding #RenderScreensCb.IsChecked}">
                                        <ctl:SettingRow ConfigKey="python.threadedupload">
                                            <CheckBox x:Name="RenderScreensThreadCb" Content="{Binding [RenderScreensThread], Source={x:Static starterNg:App.Loc}}" />
                                        </ctl:SettingRow>
                                        <ctl:SettingRow ConfigKey="python.updatetime" Label="{Binding [PyScreenPriority], Source={x:Static starterNg:App.Loc}}"
                                                        Description="{Binding [PyScreenPriorityDesc], Source={x:Static starterNg:App.Loc}}">
                                            <ComboBox x:Name="PyScreenPriorityCb" Classes="Localized">
                                                <ComboBoxItem Tag="200" Content="{Binding [PyPriorityNormal], Source={x:Static starterNg:App.Loc}}" />
                                                <ComboBoxItem Tag="400" Content="{Binding [PyPriorityLower], Source={x:Static starterNg:App.Loc}}" />
                                                <ComboBoxItem Tag="800" Content="{Binding [PyPriorityLowest], Source={x:Static starterNg:App.Loc}}" />
                                                <ComboBoxItem Tag="1600" Content="{Binding [PyPriorityIdle], Source={x:Static starterNg:App.Loc}}" />
                                            </ComboBox>
                                        </ctl:SettingRow>
                                        <ctl:KeySlot Key="python.fpslimit" />
                                        <ctl:KeySlot Key="python.vsync" />
                                        <ctl:KeySlot Key="python.displaywindows" />
                                    </StackPanel>
                                </StackPanel>
                            </ctl:SettingsSection>
                        </StackPanel>

                        <!-- ============================ EFFECTS ============================ -->
                        <StackPanel Tag="effects" IsVisible="False">
                            <TextBlock Classes="CategoryCaption" IsVisible="False"
                                       Text="{Binding [Effects], Source={x:Static starterNg:App.Loc}}" />
                            <ctl:SettingsSection ToggleKey="shadows" x:Name="ShadowsSection" Header="{Binding [GfxColShadows], Source={x:Static starterNg:App.Loc}}">
                                <ctl:SettingsSection.Toggle>
                                    <CheckBox x:Name="RenderShadowsCb" FontSize="12" MinHeight="0"
                                              Content="{Binding [RenderShadows], Source={x:Static starterNg:App.Loc}}" />
                                </ctl:SettingsSection.Toggle>
                                <StackPanel IsEnabled="{Binding #RenderShadowsCb.IsChecked}">
                                    <ctl:SettingRow Description="{Binding [ShadowDisplayDesc], Source={x:Static starterNg:App.Loc}}" ConfigKey="gfx.shadow.rank.cutoff" Label="{Binding [ShadowDisplay], Source={x:Static starterNg:App.Loc}}">
                                        <ComboBox x:Name="ShadowDisplayCb" Classes="Localized" SelectedIndex="0">
                                            <ComboBoxItem Content="{Binding [CSROnlyImportant], Source={x:Static starterNg:App.Loc}}" />
                                            <ComboBoxItem Content="{Binding [CSRLimited], Source={x:Static starterNg:App.Loc}}" />
                                            <ComboBoxItem Content="{Binding [CSRAll], Source={x:Static starterNg:App.Loc}}" />
                                        </ComboBox>
                                    </ctl:SettingRow>
                                    <ctl:SettingRow ConfigKey="shadowtune" x:Name="ShadowResolutionRow"
                                                    Label="{Binding [ShadowsResolution], Source={x:Static starterNg:App.Loc}}">
                                        <Slider Name="shaderResolutionSlider" Minimum="9" Maximum="13" TickFrequency="1"
                                                IsSnapToTickEnabled="True" Value="12"
                                                ValueChanged="shaderResolutionSlider_OnValueChanged" />
                                    </ctl:SettingRow>
                                    <ctl:SettingRow ConfigKey="shadowtune" x:Name="ShadowRangeRow"
                                                    Label="{Binding [ShaderRange], Source={x:Static starterNg:App.Loc}}"
                                                    Description="{Binding [ShaderRangeDesc], Source={x:Static starterNg:App.Loc}}">
                                        <!-- The simulator's floor follows the map size: see shaderResolutionSlider_OnValueChanged. -->
                                        <Slider Name="shaderRange" Minimum="75" Maximum="600" TickFrequency="5"
                                                IsSnapToTickEnabled="True" Value="150"
                                                ValueChanged="QualitySlider_OnValueChanged" />
                                    </ctl:SettingRow>
                                    <ctl:SettingRow ConfigKey="gfx.shadows.cab.range" x:Name="CabShadowRangeRow"
                                                    Label="{Binding [CabShadowsRange], Source={x:Static starterNg:App.Loc}}"
                                                    Description="{Binding [CabShadowsRangeDesc], Source={x:Static starterNg:App.Loc}}">
                                        <Slider Name="cabShaderSourceRange" Minimum="0" Maximum="100" TickFrequency="10"
                                                IsSnapToTickEnabled="True" Value="30"
                                                ValueChanged="QualitySlider_OnValueChanged" />
                                    </ctl:SettingRow>
                                    <ctl:SettingRow ConfigKey="gfx.shadow.angle.min" x:Name="ShadowAngleLimitRow"
                                                    Label="{Binding [ShadowAngleLimit], Source={x:Static starterNg:App.Loc}}"
                                                    Description="{Binding [ShadowAngleLimitDesc], Source={x:Static starterNg:App.Loc}}">
                                        <StackPanel>
                                            <Slider x:Name="ShadowAngleLimitSlider" Minimum="0.2" Maximum="1.0"
                                                    TickFrequency="0.05" IsSnapToTickEnabled="True" Value="0.2" HorizontalAlignment="Stretch"
                                                    ValueChanged="QualitySlider_OnValueChanged" />
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Classes="FieldHint"
                                                           Text="{Binding [ShadowLimitShort], Source={x:Static starterNg:App.Loc}}" />
                                                <TextBlock Classes="FieldHint"
                                                           Text="{Binding [ShadowLimitNone], Source={x:Static starterNg:App.Loc}}" />
                                            </DockPanel>
                                        </StackPanel>
                                    </ctl:SettingRow>
                                </StackPanel>
                            </ctl:SettingsSection>

                            <ctl:SettingsSection x:Name="LightsSection" Header="{Binding [GfxColLights], Source={x:Static starterNg:App.Loc}}">
                                <StackPanel>
                                    <ctl:SettingRow x:Name="DynamicLightsRow" Description="{Binding [DynamicLightsDesc], Source={x:Static starterNg:App.Loc}}" ConfigKey="dynamiclights" Label="{Binding [DynamicLights], Source={x:Static starterNg:App.Loc}}"
                                                    ValueText="{Binding #DynamicLightsSlider.Value, StringFormat='{}{0:0}'}">
                                        <Slider x:Name="DynamicLightsSlider" Minimum="0" Maximum="7" TickFrequency="1"
                                                IsSnapToTickEnabled="True" Value="7" />
                                    </ctl:SettingRow>
                                </StackPanel>
                            </ctl:SettingsSection>

                            <ctl:SettingsSection x:Name="ReflectionsSection" Header="{Binding [GfxColReflections], Source={x:Static starterNg:App.Loc}}">
                                <StackPanel>
                                    <ctl:SettingRow ConfigKey="gfx.envmap.enabled" Description="{Binding [ReflectionsCubeMapDesc], Source={x:Static starterNg:App.Loc}}">
                                        <CheckBox x:Name="ReflectionsCubeMapCb" Content="{Binding [ReflectionsCubeMap], Source={x:Static starterNg:App.Loc}}" />
                                    </ctl:SettingRow>
                                    <StackPanel x:Name="ReflectionRows">
                                        <ctl:SettingRow ConfigKey="gfx.reflections.fidelity" Label="{Binding [ReflectionsDetails], Source={x:Static starterNg:App.Loc}}"
                                                        Description="{Binding [ReflectionsDetailsDesc], Source={x:Static starterNg:App.Loc}}">
                                            <ComboBox x:Name="ReflectionsDetailsCb" Classes="Localized" SelectedIndex="0">
                                                <ComboBoxItem Content="{Binding [RDTerrain], Source={x:Static starterNg:App.Loc}}" />
                                                <ComboBoxItem Content="{Binding [RDTerrainModels], Source={x:Static starterNg:App.Loc}}" />
                                                <ComboBoxItem Content="{Binding [RDTerrainModelsVehicles], Source={x:Static starterNg:App.Loc}}" />
                                            </ComboBox>
                                        </ctl:SettingRow>
                                        <ctl:SettingRow ConfigKey="gfx.reflections.framerate" x:Name="ReflectionsFramerateRow"
                                                        Label="{Binding [ReflectionsFramerate], Source={x:Static starterNg:App.Loc}}"
                                                        Description="{Binding [ReflectionsFramerateDesc], Source={x:Static starterNg:App.Loc}}">
                                            <!-- Moves through Steps.ReflectionUpdates; see SliderSteps. -->
                                            <Slider Name="reflectionsFramerate"
                                                    ValueChanged="QualitySlider_OnValueChanged" />
                                        </ctl:SettingRow>
                                        <ctl:KeySlot Key="gfx.reflections.range_instances" />
                                        <ctl:KeySlot Key="gfx.reflections.range_vehicles" />
                                    </StackPanel>
                                </StackPanel>
                            </ctl:SettingsSection>

                            <ctl:SettingsSection x:Name="PostFxSection" Header="{Binding [GfxColPostFx], Source={x:Static starterNg:App.Loc}}">
                                <StackPanel>
                                    <ctl:SettingRow ConfigKey="gfx.postfx.motionblur.enabled">
                                        <CheckBox x:Name="MotionBlurCb" Content="{Binding [MotionBlur], Source={x:Static starterNg:App.Loc}}" />
                                    </ctl:SettingRow>
                                    <ctl:KeySlot Key="gfx.postfx.motionblur.shutter" />
                                    <ctl:SettingRow ConfigKey="gfx.postfx.chromaticaberration.enabled">
                                        <CheckBox x:Name="ChromaticAberrationCb" Content="{Binding [ChromaticAberration], Source={x:Static starterNg:App.Loc}}" />
                                    </ctl:SettingRow>
                                </StackPanel>
                            </ctl:SettingsSection>

                            <ctl:SettingsSection x:Name="NatureSection" Header="{Binding [GfxColNature], Source={x:Static starterNg:App.Loc}}">
                                <StackPanel>
                                    <ctl:SettingRow ConfigKey="gfx.smoke" Margin="0,0,0,4">
                                        <CheckBox x:Name="SmokeDisplayCb" Content="{Binding [SmokeDisplay], Source={x:Static starterNg:App.Loc}}" />
                                    </ctl:SettingRow>
                                    <ctl:SettingRow ConfigKey="gfx.smoke.fidelity" x:Name="SmokeParticlesRow"
                                                    Label="{Binding [SmokeParticlesMultiplier], Source={x:Static starterNg:App.Loc}}"
                                                    IsEnabled="{Binding #SmokeDisplayCb.IsChecked}">
                                        <Slider x:Name="SmokeParticlesSlider" Minimum="1" Maximum="4" TickFrequency="1"
                                                IsSnapToTickEnabled="True" Value="2"
                                                ValueChanged="QualitySlider_OnValueChanged" />
                                    </ctl:SettingRow>
                                </StackPanel>
                            </ctl:SettingsSection>
                        </StackPanel>

                        <!-- ============================= SOUND ============================= -->
                        <StackPanel Tag="sound" IsVisible="False">
                            <TextBlock Classes="CategoryCaption" IsVisible="False"
                                       Text="{Binding [Sounds], Source={x:Static starterNg:App.Loc}}" />
                            <ctl:SettingsSection ToggleKey="soundenabled" Header="{Binding [Sounds], Source={x:Static starterNg:App.Loc}}">
                                <ctl:SettingsSection.Toggle>
                                    <CheckBox x:Name="EnableSoundsCb" FontSize="12" MinHeight="0"
                                              Content="{Binding [EnableSounds], Source={x:Static starterNg:App.Loc}}" />
                                </ctl:SettingsSection.Toggle>
                                <StackPanel IsEnabled="{Binding #EnableSoundsCb.IsChecked}">
                                    <ctl:SettingRow ConfigKey="sound.volume" Label="{Binding [Volume], Source={x:Static starterNg:App.Loc}}"
                                                    ValueText="{Binding #VolumeSlider.Value, StringFormat='{}{0:0}%'}">
                                        <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" TickFrequency="5"
                                                IsSnapToTickEnabled="True" Value="100" />
                                    </ctl:SettingRow>
                                    <ctl:SettingRow ConfigKey="sound.volume.radio" Label="{Binding [RadiophoneVolume], Source={x:Static starterNg:App.Loc}}"
                                                    ValueText="{Binding #RadioVolumeSlider.Value, StringFormat='{}{0:0}%'}">
                                        <Slider x:Name="RadioVolumeSlider" Minimum="0" Maximum="100" TickFrequency="5"
                                                IsSnapToTickEnabled="True" Value="100" />
                                    </ctl:SettingRow>
                                    <ctl:SettingRow ConfigKey="sound.volume.vehicle" Label="{Binding [VehiclesVolume], Source={x:Static starterNg:App.Loc}}"
                                                    ValueText="{Binding #VehiclesVolumeSlider.Value, StringFormat='{}{0:0}%'}">
                                        <Slider x:Name="VehiclesVolumeSlider" Minimum="0" Maximum="100" TickFrequency="5"
                                                IsSnapToTickEnabled="True" Value="100" />
                                    </ctl:SettingRow>
                                    <ctl:SettingRow ConfigKey="sound.volume.positional" Label="{Binding [PositionedSoundsVolume], Source={x:Static starterNg:App.Loc}}"
                                                    ValueText="{Binding #PositionalVolumeSlider.Value, StringFormat='{}{0:0}%'}">
                                        <Slider x:Name="PositionalVolumeSlider" Minimum="0" Maximum="100" TickFrequency="5"
                                                IsSnapToTickEnabled="True" Value="100" />
                                    </ctl:SettingRow>
                                    <ctl:SettingRow ConfigKey="sound.volume.ambient" Label="{Binding [AmbientVolume], Source={x:Static starterNg:App.Loc}}"
                                                    ValueText="{Binding #AmbientVolumeSlider.Value, StringFormat='{}{0:0}%'}">
                                        <Slider x:Name="AmbientVolumeSlider" Minimum="0" Maximum="100" TickFrequency="5"
                                                IsSnapToTickEnabled="True" Value="100" />
                                    </ctl:SettingRow>
                                </StackPanel>
                            </ctl:SettingsSection>
                        </StackPanel>

                        <!-- ============================ PHYSICS ============================ -->
                        <StackPanel Tag="physics" IsVisible="False">
                            <TextBlock Classes="CategoryCaption" IsVisible="False"
                                       Text="{Binding [Physics], Source={x:Static starterNg:App.Loc}}" />
                            <ctl:SettingsSection Header="{Binding [Physics], Source={x:Static starterNg:App.Loc}}">
                                <StackPanel>
                                    <ctl:SettingRow ConfigKey="fullphysics" Description="{Binding [PhysicsAccuracyIncreasedDesc], Source={x:Static starterNg:App.Loc}}">
                                        <CheckBox x:Name="PhysicsAccuracyCb" Content="{Binding [PhysicsAccuracyIncreased], Source={x:Static starterNg:App.Loc}}" />
                                    </ctl:SettingRow>
                                    <ctl:SettingRow ConfigKey="enabletraction" Description="{Binding [BreakingPantographPossibilityDesc], Source={x:Static starterNg:App.Loc}}">
                                        <CheckBox x:Name="PantographBreakCb" Content="{Binding [BreakingPantographPossibility], Source={x:Static starterNg:App.Loc}}" />
                                    </ctl:SettingRow>
                                    <ctl:SettingRow ConfigKey="livetraction" Description="{Binding [PowerOverheadLineOnlyDesc], Source={x:Static starterNg:App.Loc}}">
                                        <CheckBox x:Name="OverheadOnlyCb" Content="{Binding [PowerOverheadLineOnly], Source={x:Static starterNg:App.Loc}}" />
                                    </ctl:SettingRow>
                                    <ctl:SettingRow Description="{Binding [SaveSpeedometerTapesDesc], Source={x:Static starterNg:App.Loc}}" ConfigKey="physicslog">
                                        <CheckBox x:Name="SpeedometerTapesCb" Content="{Binding [SaveSpeedometerTapes], Source={x:Static starterNg:App.Loc}}" />
                                    </ctl:SettingRow>
                                    <ctl:SettingRow ConfigKey="debuglog">
                                        <CheckBox x:Name="SimLogsCb" Content="{Binding [SaveSimLogs], Source={x:Static starterNg:App.Loc}}" />
                                    </ctl:SettingRow>
                                    <ctl:SettingRow Description="{Binding [KeepPrevLogsDesc], Source={x:Static starterNg:App.Loc}}" ConfigKey="multiplelogs">
                                        <CheckBox x:Name="KeepLogsCb" Content="{Binding [KeepPrevLogs], Source={x:Static starterNg:App.Loc}}" />
                                    </ctl:SettingRow>
                                    <ctl:SettingRow Description="{Binding [DisplaySimulationDesc], Source={x:Static starterNg:App.Loc}}" ConfigKey="gfx.skiprendering">
                                        <CheckBox x:Name="DisplaySimulationCb" Content="{Binding [DisplaySimulation], Source={x:Static starterNg:App.Loc}}" />
                                    </ctl:SettingRow>
                                    <ctl:SettingRow ConfigKey="debuglog">
                                        <CheckBox x:Name="DebugLogVisibleCb" Content="{Binding [DebugLogVisible], Source={x:Static starterNg:App.Loc}}" />
                                    </ctl:SettingRow>
                                    <ctl:SettingRow Description="{Binding [CrashDamageDesc], Source={x:Static starterNg:App.Loc}}" ConfigKey="crashdamage">
                                        <CheckBox x:Name="CrashDamageCb" Content="{Binding [CrashDamage], Source={x:Static starterNg:App.Loc}}" />
                                    </ctl:SettingRow>

                                    <ctl:SettingRow ConfigKey="friction" x:Name="FrictionRow" Label="{Binding [Friction], Source={x:Static starterNg:App.Loc}}"
                                                    Description="{Binding [FrictionDesc], Source={x:Static starterNg:App.Loc}}">
                                        <Slider x:Name="FrictionSlider" Minimum="0.1" Maximum="3.0" TickFrequency="0.1" Value="1.0"
                                                ValueChanged="QualitySlider_OnValueChanged" />
                                    </ctl:SettingRow>
                                    <ctl:SettingRow ConfigKey="brakestep" x:Name="BrakeStepRow" Label="{Binding [BrakeStep], Source={x:Static starterNg:App.Loc}}"
                                                    Description="{Binding [BrakeStepDesc], Source={x:Static starterNg:App.Loc}}">
                                        <Slider x:Name="BrakeStepSlider" Minimum="0.4" Maximum="3.0" TickFrequency="0.1" Value="1.0"
                                                ValueChanged="QualitySlider_OnValueChanged" />
                                    </ctl:SettingRow>
                                    <ctl:SettingRow ConfigKey="brakespeed" x:Name="BrakeSpeedRow" Label="{Binding [BrakeSpeed], Source={x:Static starterNg:App.Loc}}"
                                                    Description="{Binding [BrakeSpeedDesc], Source={x:Static starterNg:App.Loc}}">
                                        <Slider x:Name="BrakeSpeedSlider" Minimum="0.4" Maximum="3.0" TickFrequency="0.1" Value="1.0"
                                                ValueChanged="QualitySlider_OnValueChanged" />
                                    </ctl:SettingRow>
                                </StackPanel>
                            </ctl:SettingsSection>
                        </StackPanel>

                        <!-- ============================ DEVICES ============================ -->
                        <StackPanel Tag="devices" IsVisible="False">
                            <TextBlock Classes="CategoryCaption" IsVisible="False"
                                       Text="{Binding [Communication], Source={x:Static starterNg:App.Loc}}" />
                            <ctl:SettingsSection Header="{Binding [Communication], Source={x:Static starterNg:App.Loc}}">
                                <StackPanel>
                                    <ctl:SettingRow ConfigKey="input.gamepad" Description="{Binding [GamepadSignalIgnoreDesc], Source={x:Static starterNg:App.Loc}}">
                                        <CheckBox x:Name="GamepadIgnoreCb" Content="{Binding [GamepadSignalIgnore], Source={x:Static starterNg:App.Loc}}" />
                                    </ctl:SettingRow>
                                    <ctl:SettingRow ConfigKey="feedbackmode" Label="{Binding [Feedback], Source={x:Static starterNg:App.Loc}}"
                                                    Description="{Binding [FeedbackDesc], Source={x:Static starterNg:App.Loc}}">
                                        <ComboBox x:Name="FeedbackCb" Classes="Localized" SelectedIndex="0">
                                            <ComboBoxItem Tag="0" Content="{Binding [FeedbackOff], Source={x:Static starterNg:App.Loc}}" />
                                            <ComboBoxItem Tag="1" Content="{Binding [FeedbackCASHP], Source={x:Static starterNg:App.Loc}}" />
                                            <ComboBoxItem Tag="2" Content="{Binding [FeedbackCA], Source={x:Static starterNg:App.Loc}}" />
                                            <ComboBoxItem Tag="3" Content="{Binding [FeedbackLPT], Source={x:Static starterNg:App.Loc}}" />
                                            <ComboBoxItem Tag="4" Content="{Binding [FeedbackPoKeys], Source={x:Static starterNg:App.Loc}}" />
                                            <ComboBoxItem Tag="5" Content="{Binding [FeedbackSP], Source={x:Static starterNg:App.Loc}}" />
                                        </ComboBox>
                                    </ctl:SettingRow>
                                    <ctl:SettingRow ConfigKey="feedbackport" x:Name="FeedbackPortRow" IsVisible="False"
                                                    Label="{Binding [FeedbackPort], Source={x:Static starterNg:App.Loc}}"
                                                    Description="{Binding [FeedbackPortDesc], Source={x:Static starterNg:App.Loc}}">
                                        <NumericUpDown x:Name="FeedbackPortNud" Minimum="0" Maximum="65535" Value="888"
                                                       Increment="1" FormatString="0" />
                                    </ctl:SettingRow>
                                </StackPanel>
                            </ctl:SettingsSection>

                            <!-- Shown for the serial port feedback; saved with everything else on this page. -->
                            <ctl:SettingsSection x:Name="UartSettings" Header="{Binding [UartSection], Source={x:Static starterNg:App.Loc}}">
                                <StackPanel>
                                    <ctl:SettingRow ConfigKey="uart">
                                        <CheckBox x:Name="UartEnabledCb" Content="{Binding [UartEnable], Source={x:Static starterNg:App.Loc}}" />
                                    </ctl:SettingRow>
                                    <ctl:SettingRow ConfigKey="uart" Classes="KeyAbove" Label="{Binding [UartPort], Source={x:Static starterNg:App.Loc}}">
                                        <StackPanel Classes="Field" Spacing="4">
                                            <ComboBox x:Name="UartPortCb" IsEditable="True" HorizontalAlignment="Stretch"
                                                      PlaceholderText="{Binding [UartPortNone], Source={x:Static starterNg:App.Loc}}" />
                                            <TextBlock x:Name="UartPortWarning" IsVisible="False" FontSize="12" TextWrapping="Wrap"
                                                       Foreground="#E0A030"
                                                       Text="{Binding [UartPortMissing], Source={x:Static starterNg:App.Loc}}" />
                                        </StackPanel>
                                    </ctl:SettingRow>
                                    <ctl:SettingRow ConfigKey="uart" Classes="KeyAbove" Label="{Binding [UartBaud], Source={x:Static starterNg:App.Loc}}">
                                        <ComboBox x:Name="UartBaudCb" />
                                    </ctl:SettingRow>
                                    <ctl:SettingRow ConfigKey="uart" Classes="KeyAbove" Label="{Binding [UartEvery], Source={x:Static starterNg:App.Loc}}">
                                        <NumericUpDown x:Name="UartEveryNud" Minimum="0" Maximum="10" Increment="0.05" FormatString="0.###" />
                                    </ctl:SettingRow>
                                    <ctl:SettingRow ConfigKey="uarttune" Label="{Binding [UartTune], Source={x:Static starterNg:App.Loc}}">
                                        <StackPanel Classes="Field" Spacing="4">
                                            <TextBox x:Name="UartTuneBox" TextWrapping="Wrap"
                                                     PlaceholderText="{Binding [UartTunePlaceholder], Source={x:Static starterNg:App.Loc}}" />
                                            <TextBlock x:Name="UartTuneWarning" IsVisible="False" FontSize="12" TextWrapping="Wrap"
                                                       Foreground="#E0A030" />
                                        </StackPanel>
                                    </ctl:SettingRow>
                                    <ctl:SettingRow ConfigKey="uartdebug">
                                        <CheckBox x:Name="UartDebugCb" Content="{Binding [UartDebug], Source={x:Static starterNg:App.Loc}}" />
                                    </ctl:SettingRow>
                                    <ctl:SettingRow ConfigKey="uartfeature" Classes="TopLabel" Label="{Binding [UartFeature], Source={x:Static starterNg:App.Loc}}">
                                        <UniformGrid Columns="2" RowSpacing="8" ColumnSpacing="8">
                                            <CheckBox x:Name="UartMainCb" Content="{Binding [UartMain], Source={x:Static starterNg:App.Loc}}" />
                                            <CheckBox x:Name="UartScndCb" Content="{Binding [UartScnd], Source={x:Static starterNg:App.Loc}}" />
                                            <CheckBox x:Name="UartTrainCb" Content="{Binding [UartTrain], Source={x:Static starterNg:App.Loc}}" />
                                            <CheckBox x:Name="UartLocalCb" Content="{Binding [UartLocal], Source={x:Static starterNg:App.Loc}}" />
                                            <CheckBox x:Name="UartRadioVolumeCb" Content="{Binding [UartRadioVolume], Source={x:Static starterNg:App.Loc}}" />
                                            <CheckBox x:Name="UartRadioChannelCb" Content="{Binding [UartRadioChannel], Source={x:Static starterNg:App.Loc}}" />
                                        </UniformGrid>
                                    </ctl:SettingRow>
                                </StackPanel>
                            </ctl:SettingsSection>
                        </StackPanel>

                        <!-- ============================ ADVANCED ============================ -->
                        <StackPanel Tag="advanced" IsVisible="False">
                            <TextBlock Classes="CategoryCaption" IsVisible="False"
                                       Text="{Binding [Advanced], Source={x:Static starterNg:App.Loc}}" />
                            <ctl:SettingsSection Header="{Binding [AdvancedResources], Source={x:Static starterNg:App.Loc}}">
                                <StackPanel>
                                    <ctl:SettingRow ConfigKey="compresstex" Description="{Binding [CompressTexturesDesc], Source={x:Static starterNg:App.Loc}}">
                                        <CheckBox x:Name="CompressTexCb" Content="{Binding [CompressTextures], Source={x:Static starterNg:App.Loc}}" />
                                    </ctl:SettingRow>
                                    <ctl:SettingRow ConfigKey="scalespeculars" Description="{Binding [ScaleSpecularsDesc], Source={x:Static starterNg:App.Loc}}">
                                        <CheckBox x:Name="ScaleSpecularsCb" Content="{Binding [ScaleSpeculars], Source={x:Static starterNg:App.Loc}}" />
                                    </ctl:SettingRow>
                                    <ctl:SettingRow ConfigKey="python.mipmaps" Description="{Binding [ScreenMipmapsDesc], Source={x:Static starterNg:App.Loc}}">
                                        <CheckBox x:Name="ScreenMipmapsCb" Content="{Binding [ScreenMipmaps], Source={x:Static starterNg:App.Loc}}" />
                                    </ctl:SettingRow>
                                    <ctl:SettingRow ConfigKey="gfx.shadergamma" Description="{Binding [ShaderGammaDesc], Source={x:Static starterNg:App.Loc}}">
                                        <CheckBox x:Name="ShaderGammaCb" Content="{Binding [ShaderGamma], Source={x:Static starterNg:App.Loc}}" />
                                    </ctl:SettingRow>
                                    <ctl:SettingRow ConfigKey="gfx.usegles" Description="{Binding [UseGLESDesc], Source={x:Static starterNg:App.Loc}}">
                                        <CheckBox x:Name="UseGlesCb" Content="{Binding [UseGLES], Source={x:Static starterNg:App.Loc}}" />
                                    </ctl:SettingRow>
                                    <ctl:SettingRow ConfigKey="convertmodels" Description="{Binding [ExtendedModelConversionDesc], Source={x:Static starterNg:App.Loc}}">
                                        <CheckBox x:Name="ConvertModelsCb" Content="{Binding [ExtendedModelConversion], Source={x:Static starterNg:App.Loc}}" />
                                    </ctl:SettingRow>
                                    <ctl:SettingRow ConfigKey="gfx.resource.sweep" Description="{Binding [GfxResourceSweepDesc], Source={x:Static starterNg:App.Loc}}">
                                        <CheckBox x:Name="ResourceSweepCb" Content="{Binding [GfxResourceSweep], Source={x:Static starterNg:App.Loc}}" />
                                    </ctl:SettingRow>
                                    <ctl:SettingRow ConfigKey="gfx.resource.move" Description="{Binding [GfxResourceMoveDesc], Source={x:Static starterNg:App.Loc}}">
                                        <CheckBox x:Name="ResourceMoveCb" Content="{Binding [GfxResourceMove], Source={x:Static starterNg:App.Loc}}" />
                                    </ctl:SettingRow>
                                    <ctl:SettingRow ConfigKey="async.trainThreads" x:Name="TrainThreadsRow"
                                                    Label="{Binding [TrainPhysicsThreads], Source={x:Static starterNg:App.Loc}}"
                                                    Description="{Binding [TrainPhysicsThreadsDesc], Source={x:Static starterNg:App.Loc}}">
                                        <Slider x:Name="TrainThreadsSlider" Minimum="0" Maximum="16" TickFrequency="1"
                                                IsSnapToTickEnabled="True" ValueChanged="QualitySlider_OnValueChanged" />
                                    </ctl:SettingRow>
                                    <ctl:SettingRow ConfigKey="starter.ignoreirrelevant" Description="{Binding [IgnoreIrrelevantTrainsDesc], Source={x:Static starterNg:App.Loc}}">
                                        <CheckBox x:Name="IgnoreIrrelevantCb" Content="{Binding [IgnoreIrrelevantTrains], Source={x:Static starterNg:App.Loc}}" />
                                    </ctl:SettingRow>
                                </StackPanel>
                            </ctl:SettingsSection>

                            <ctl:SettingsSection Header="{Binding [AdvancedLogTools], Source={x:Static starterNg:App.Loc}}">
                                <StackPanel>
                                    <ctl:SettingRow Description="{Binding [OpenLogToolsDesc], Source={x:Static starterNg:App.Loc}}">
                                        <Button x:Name="OpenLogToolsButton" Classes="Flat" Cursor="Hand"
                                                HorizontalContentAlignment="Center"
                                                Click="OpenLogToolsButton_OnClick"
                                                Content="{Binding [OpenLogTools], Source={x:Static starterNg:App.Loc}}" />
                                    </ctl:SettingRow>
                                </StackPanel>
                            </ctl:SettingsSection>

                            <!-- What only the new simulator reads; an older one passes over these keys. -->
                            <ctl:SettingsSection Header="{Binding [GfxColNewRenderer], Source={x:Static starterNg:App.Loc}}">
                                <StackPanel>
                                    <TextBlock Classes="SettingNote" Margin="0,0,0,11"
                                               Text="{Binding [GfxNewRendererNote], Source={x:Static starterNg:App.Loc}}" />
                                    <ctl:SettingRow x:Name="VulkanDeviceRow" ConfigKey="gfx.vulkan.device"
                                                    Label="{Binding [VulkanDevice], Source={x:Static starterNg:App.Loc}}"
                                                    Description="{Binding [VulkanDeviceDesc], Source={x:Static starterNg:App.Loc}}">
                                        <TextBox x:Name="VulkanDeviceTb" PlaceholderText="{Binding [VulkanDeviceAuto], Source={x:Static starterNg:App.Loc}}" />
                                    </ctl:SettingRow>
                                    <ctl:SettingRow x:Name="DlssPresetRow" ConfigKey="gfx.dlss.preset"
                                                    Label="{Binding [DlssPreset], Source={x:Static starterNg:App.Loc}}"
                                                    Description="{Binding [DlssPresetDesc], Source={x:Static starterNg:App.Loc}}">
                                        <StackPanel Spacing="6">
                                            <ComboBox x:Name="DlssPresetCb" Classes="Localized" SelectedIndex="0">
                                                <ComboBoxItem Tag="default" Content="{Binding [DlssPresetDefault], Source={x:Static starterNg:App.Loc}}" />
                                                <ComboBoxItem Tag="k" Content="{Binding [DlssPresetK], Source={x:Static starterNg:App.Loc}}" />
                                                <ComboBoxItem Tag="j" Content="{Binding [DlssPresetJ], Source={x:Static starterNg:App.Loc}}" />
                                                <ComboBoxItem Tag="m" Content="{Binding [DlssPresetM], Source={x:Static starterNg:App.Loc}}" />
                                                <ComboBoxItem Tag="l" Content="{Binding [DlssPresetL], Source={x:Static starterNg:App.Loc}}" />
                                            </ComboBox>
                                            <TextBlock x:Name="DlssPresetInfo" Classes="FieldHint" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </ctl:SettingRow>
                                    <ctl:SettingRow x:Name="FrameGenerationRow" ConfigKey="gfx.framegeneration"
                                                    Label="{Binding [FrameGeneration], Source={x:Static starterNg:App.Loc}}"
                                                    Description="{Binding [FrameGenerationDesc], Source={x:Static starterNg:App.Loc}}">
                                        <StackPanel Spacing="6">
                                            <ComboBox x:Name="FrameGenerationCb" Classes="Localized" SelectedIndex="0">
                                                <ComboBoxItem Tag="1" Content="{Binding [LevelOff], Source={x:Static starterNg:App.Loc}}" />
                                                <ComboBoxItem Tag="2" Content="x2" />
                                                <ComboBoxItem Tag="3" Content="x3" />
                                                <ComboBoxItem Tag="4" Content="x4" />
                                            </ComboBox>
                                            <TextBlock x:Name="FrameGenerationNote" Classes="SettingNote" IsVisible="False" />
                                        </StackPanel>
                                    </ctl:SettingRow>
                                    <ctl:SettingRow x:Name="ReflexRow" ConfigKey="gfx.reflex"
                                                    Label="{Binding [Reflex], Source={x:Static starterNg:App.Loc}}"
                                                    Description="{Binding [ReflexDesc], Source={x:Static starterNg:App.Loc}}">
                                        <StackPanel Spacing="6">
                                            <ComboBox x:Name="ReflexCb" Classes="Localized" SelectedIndex="0">
                                                <ComboBoxItem Tag="0" Content="{Binding [LevelOff], Source={x:Static starterNg:App.Loc}}" />
                                                <ComboBoxItem Tag="1" Content="{Binding [ReflexOn], Source={x:Static starterNg:App.Loc}}" />
                                                <ComboBoxItem Tag="2" Content="{Binding [ReflexBoost], Source={x:Static starterNg:App.Loc}}" />
                                            </ComboBox>
                                            <TextBlock x:Name="ReflexNote" Classes="SettingNote" IsVisible="False" />
                                        </StackPanel>
                                    </ctl:SettingRow>
                                    <ctl:SettingRow x:Name="RayTracingRow" ConfigKey="gfx.raytracing" Description="{Binding [RayTracingDesc], Source={x:Static starterNg:App.Loc}}">
                                        <CheckBox x:Name="RayTracingCb" Content="{Binding [RayTracing], Source={x:Static starterNg:App.Loc}}" />
                                    </ctl:SettingRow>
                                    <ctl:SettingRow x:Name="RayTracingRangeRow" ConfigKey="gfx.raytracing.range"
                                                    Label="{Binding [RayTracingRange], Source={x:Static starterNg:App.Loc}}"
                                                    ValueText="{Binding #RayTracingRangeSlider.Value, StringFormat='{}{0:0} m'}">
                                        <Slider x:Name="RayTracingRangeSlider" Minimum="50" Maximum="2000" TickFrequency="50" IsSnapToTickEnabled="True" Value="500" />
                                    </ctl:SettingRow>
                                    <ctl:SettingRow ConfigKey="gfx.ssr" Label="{Binding [Ssr], Source={x:Static starterNg:App.Loc}}"
                                                    Description="{Binding [SsrDesc], Source={x:Static starterNg:App.Loc}}">
                                        <ComboBox x:Name="SsrCb" Classes="Localized" SelectedIndex="0">
                                            <ComboBoxItem Tag="0" Content="{Binding [LevelOff], Source={x:Static starterNg:App.Loc}}" />
                                            <ComboBoxItem Tag="1" Content="{Binding [LevelLow], Source={x:Static starterNg:App.Loc}}" />
                                            <ComboBoxItem Tag="2" Content="{Binding [LevelMedium], Source={x:Static starterNg:App.Loc}}" />
                                            <ComboBoxItem Tag="3" Content="{Binding [LevelHigh], Source={x:Static starterNg:App.Loc}}" />
                                        </ComboBox>
                                    </ctl:SettingRow>
                                    <ctl:SettingRow ConfigKey="gfx.lights.clustered" Description="{Binding [LightsClusteredDesc], Source={x:Static starterNg:App.Loc}}">
                                        <CheckBox x:Name="LightsClusteredCb" Content="{Binding [LightsClustered], Source={x:Static starterNg:App.Loc}}" />
                                    </ctl:SettingRow>
                                    <ctl:SettingRow ConfigKey="gfx.lights.shadows" Label="{Binding [LightShadows], Source={x:Static starterNg:App.Loc}}"
                                                    Description="{Binding [LightShadowsDesc], Source={x:Static starterNg:App.Loc}}">
                                        <ComboBox x:Name="LightShadowsCb" Classes="Localized" SelectedIndex="0">
                                            <ComboBoxItem Tag="0" Content="{Binding [LevelOff], Source={x:Static starterNg:App.Loc}}" />
                                            <ComboBoxItem Tag="1" Content="{Binding [LevelLow], Source={x:Static starterNg:App.Loc}}" />
                                            <ComboBoxItem Tag="2" Content="{Binding [LevelMedium], Source={x:Static starterNg:App.Loc}}" />
                                            <ComboBoxItem Tag="3" Content="{Binding [LevelHigh], Source={x:Static starterNg:App.Loc}}" />
                                        </ComboBox>
                                    </ctl:SettingRow>
                                    <ctl:SettingRow ConfigKey="gfx.contactshadows" Label="{Binding [ContactShadows], Source={x:Static starterNg:App.Loc}}"
                                                    Description="{Binding [ContactShadowsDesc], Source={x:Static starterNg:App.Loc}}">
                                        <ComboBox x:Name="ContactShadowsCb" Classes="Localized" SelectedIndex="0">
                                            <ComboBoxItem Tag="0" Content="{Binding [LevelOff], Source={x:Static starterNg:App.Loc}}" />
                                            <ComboBoxItem Tag="1" Content="{Binding [LevelLow], Source={x:Static starterNg:App.Loc}}" />
                                            <ComboBoxItem Tag="2" Content="{Binding [LevelMedium], Source={x:Static starterNg:App.Loc}}" />
                                            <ComboBoxItem Tag="3" Content="{Binding [LevelHigh], Source={x:Static starterNg:App.Loc}}" />
                                        </ComboBox>
                                    </ctl:SettingRow>
                                    <ctl:SettingRow ConfigKey="gfx.shadow.sdsm" Description="{Binding [ShadowSdsmDesc], Source={x:Static starterNg:App.Loc}}">
                                        <CheckBox x:Name="ShadowSdsmCb" Content="{Binding [ShadowSdsm], Source={x:Static starterNg:App.Loc}}" />
                                    </ctl:SettingRow>
                                    <ctl:SettingRow ConfigKey="gfx.postfx.ao" Label="{Binding [AmbientOcclusion], Source={x:Static starterNg:App.Loc}}"
                                                    Description="{Binding [AmbientOcclusionDesc], Source={x:Static starterNg:App.Loc}}">
                                        <ComboBox x:Name="AmbientOcclusionCb" Classes="Localized" SelectedIndex="0">
                                            <ComboBoxItem Tag="0" Content="{Binding [LevelOff], Source={x:Static starterNg:App.Loc}}" />
                                            <ComboBoxItem Tag="1" Content="SSAO" />
                                            <ComboBoxItem Tag="2" Content="GTAO" />
                                        </ComboBox>
                                    </ctl:SettingRow>
                                    <ctl:SettingRow x:Name="AoLightingRow" ConfigKey="gfx.postfx.ao.lighting" Description="{Binding [AoLightingDesc], Source={x:Static starterNg:App.Loc}}">
                                        <StackPanel Spacing="6">
                                            <CheckBox x:Name="AoLightingCb" Content="{Binding [AoLighting], Source={x:Static starterNg:App.Loc}}" />
                                            <TextBlock x:Name="AoLightingNote" Classes="SettingNote" IsVisible="False" />
                                        </StackPanel>
                                    </ctl:SettingRow>
                                    <ctl:SettingRow x:Name="AoQualityRow" ConfigKey="gfx.postfx.ao.quality" Label="{Binding [AmbientOcclusionQuality], Source={x:Static starterNg:App.Loc}}">
                                        <ComboBox x:Name="AoQualityCb" Classes="Localized" SelectedIndex="0">
                                            <ComboBoxItem Tag="2 3" Content="{Binding [QualityLow], Source={x:Static starterNg:App.Loc}}" />
                                            <ComboBoxItem Tag="3 4" Content="{Binding [QualityNormal], Source={x:Static starterNg:App.Loc}}" />
                                            <ComboBoxItem Tag="4 6" Content="{Binding [QualityHigh], Source={x:Static starterNg:App.Loc}}" />
                                            <ComboBoxItem Tag="6 8" Content="{Binding [QualityVeryHigh], Source={x:Static starterNg:App.Loc}}" />
                                        </ComboBox>
                                    </ctl:SettingRow>
                                    <ctl:SettingRow ConfigKey="gfx.cabprobe" Label="{Binding [CabProbe], Source={x:Static starterNg:App.Loc}}"
                                                    Description="{Binding [CabProbeDesc], Source={x:Static starterNg:App.Loc}}">
                                        <StackPanel Spacing="6">
                                            <ComboBox x:Name="CabProbeCb" Classes="Localized" SelectedIndex="0">
                                                <ComboBoxItem Tag="0" Content="{Binding [LevelOff], Source={x:Static starterNg:App.Loc}}" />
                                                <ComboBoxItem Tag="1" Content="{Binding [LevelLow], Source={x:Static starterNg:App.Loc}}" />
                                                <ComboBoxItem Tag="2" Content="{Binding [LevelMedium], Source={x:Static starterNg:App.Loc}}" />
                                                <ComboBoxItem Tag="3" Content="{Binding [LevelHigh], Source={x:Static starterNg:App.Loc}}" />
                                            </ComboBox>
                                            <TextBlock x:Name="CabProbeNote" Classes="SettingNote" IsVisible="False" />
                                        </StackPanel>
                                    </ctl:SettingRow>
                                    <ctl:SettingRow x:Name="CabProbeIntervalRow" ConfigKey="gfx.cabprobe.interval"
                                                    Label="{Binding [CabProbeInterval], Source={x:Static starterNg:App.Loc}}">
                                        <NumericUpDown x:Name="CabProbeIntervalNud" Minimum="1" Maximum="120" Value="4" Increment="1" FormatString="0" />
                                    </ctl:SettingRow>
                                    <ctl:SettingRow x:Name="CabProbeBounceRow" ConfigKey="gfx.cabprobe.bounce"
                                                    Label="{Binding [CabProbeBounce], Source={x:Static starterNg:App.Loc}}"
                                                    Description="{Binding [CabProbeBounceDesc], Source={x:Static starterNg:App.Loc}}"
                                                    ValueText="{Binding #CabProbeBounceSlider.Value, StringFormat='{}{0:0.0}'}">
                                        <Slider x:Name="CabProbeBounceSlider" Minimum="0" Maximum="4" TickFrequency="0.1" IsSnapToTickEnabled="True" Value="1" />
                                    </ctl:SettingRow>
                                    <ctl:SettingRow x:Name="CabProbeReflectionsRow" ConfigKey="gfx.cabprobe.reflections" Description="{Binding [CabProbeReflectionsDesc], Source={x:Static starterNg:App.Loc}}">
                                        <CheckBox x:Name="CabProbeReflectionsCb" Content="{Binding [CabProbeReflections], Source={x:Static starterNg:App.Loc}}" />
                                    </ctl:SettingRow>
                                    <ctl:SettingRow ConfigKey="gfx.fog" Description="{Binding [VolumetricFogDesc], Source={x:Static starterNg:App.Loc}}">
                                        <CheckBox x:Name="VolumetricFogCb" Content="{Binding [VolumetricFog], Source={x:Static starterNg:App.Loc}}" />
                                    </ctl:SettingRow>
                                    <ctl:SettingRow x:Name="FogQualityRow" ConfigKey="gfx.fog.quality" Label="{Binding [FogQuality], Source={x:Static starterNg:App.Loc}}">
                                        <ComboBox x:Name="FogQualityCb" Classes="Localized" SelectedIndex="0">
                                            <ComboBoxItem Tag="1" Content="{Binding [LevelLow], Source={x:Static starterNg:App.Loc}}" />
                                            <ComboBoxItem Tag="2" Content="{Binding [LevelMedium], Source={x:Static starterNg:App.Loc}}" />
                                            <ComboBoxItem Tag="3" Content="{Binding [LevelHigh], Source={x:Static starterNg:App.Loc}}" />
                                            <ComboBoxItem Tag="4" Content="{Binding [LevelUltra], Source={x:Static starterNg:App.Loc}}" />
                                        </ComboBox>
                                    </ctl:SettingRow>
                                    <ctl:SettingRow ConfigKey="gfx.clouds" Label="{Binding [Clouds], Source={x:Static starterNg:App.Loc}}"
                                                    Description="{Binding [CloudsDesc], Source={x:Static starterNg:App.Loc}}">
                                        <ComboBox x:Name="CloudsCb" Classes="Localized" SelectedIndex="0">
                                            <ComboBoxItem Tag="0" Content="{Binding [LevelOff], Source={x:Static starterNg:App.Loc}}" />
                                            <ComboBoxItem Tag="1" Content="{Binding [LevelLow], Source={x:Static starterNg:App.Loc}}" />
                                            <ComboBoxItem Tag="2" Content="{Binding [LevelMedium], Source={x:Static starterNg:App.Loc}}" />
                                            <ComboBoxItem Tag="3" Content="{Binding [LevelHigh], Source={x:Static starterNg:App.Loc}}" />
                                            <ComboBoxItem Tag="4" Content="{Binding [LevelUltra], Source={x:Static starterNg:App.Loc}}" />
                                        </ComboBox>
                                    </ctl:SettingRow>
                                    <ctl:SettingRow x:Name="CloudShadowsRow" ConfigKey="gfx.clouds.shadows">
                                        <CheckBox x:Name="CloudShadowsCb" Content="{Binding [CloudShadows], Source={x:Static starterNg:App.Loc}}" />
                                    </ctl:SettingRow>
                                    <ctl:SettingRow ConfigKey="gfx.postfx.bloom">
                                        <CheckBox x:Name="BloomCb" Content="{Binding [Bloom], Source={x:Static starterNg:App.Loc}}" />
                                    </ctl:SettingRow>
                                    <ctl:SettingRow ConfigKey="gfx.postfx.autoexposure" Description="{Binding [AutoExposureDesc], Source={x:Static starterNg:App.Loc}}">
                                        <CheckBox x:Name="AutoExposureCb" Content="{Binding [AutoExposure], Source={x:Static starterNg:App.Loc}}" />
                                    </ctl:SettingRow>
                                    <ctl:SettingRow ConfigKey="gfx.grass" Margin="0,0,0,4">
                                        <CheckBox x:Name="GrassCb" Content="{Binding [Grass], Source={x:Static starterNg:App.Loc}}" />
                                    </ctl:SettingRow>
                                    <ctl:SettingRow x:Name="GrassDistanceRow" ConfigKey="gfx.grass.distance, gfx.grass.fadedistance"
                                                    Label="{Binding [GrassDistance], Source={x:Static starterNg:App.Loc}}"
                                                    ValueText="{Binding #GrassDistanceSlider.Value, StringFormat='{}{0:0} m'}">
                                        <Slider x:Name="GrassDistanceSlider" Minimum="20" Maximum="300" TickFrequency="10" IsSnapToTickEnabled="True" Value="60" />
                                    </ctl:SettingRow>
                                    <ctl:SettingRow x:Name="GrassDensityRow" ConfigKey="gfx.grass.density"
                                                    Label="{Binding [GrassDensity], Source={x:Static starterNg:App.Loc}}"
                                                    ValueText="{Binding #GrassDensitySlider.Value, StringFormat='{}{0:0.00}'}">
                                        <Slider x:Name="GrassDensitySlider" Minimum="0.25" Maximum="2.0" TickFrequency="0.25" IsSnapToTickEnabled="True" Value="1.0" />
                                    </ctl:SettingRow>
                                    <ctl:SettingRow ConfigKey="gfx.precipitation.particles" Label="{Binding [Precipitation], Source={x:Static starterNg:App.Loc}}"
                                                    Description="{Binding [PrecipitationDesc], Source={x:Static starterNg:App.Loc}}">
                                        <ComboBox x:Name="PrecipitationCb" Classes="Localized" SelectedIndex="0">
                                            <ComboBoxItem Tag="16384" Content="{Binding [QualityVeryLow], Source={x:Static starterNg:App.Loc}}" />
                                            <ComboBoxItem Tag="32768" Content="{Binding [QualityLow], Source={x:Static starterNg:App.Loc}}" />
                                            <ComboBoxItem Tag="65536" Content="{Binding [QualityNormal], Source={x:Static starterNg:App.Loc}}" />
                                            <ComboBoxItem Tag="131072" Content="{Binding [QualityHigh], Source={x:Static starterNg:App.Loc}}" />
                                            <ComboBoxItem Tag="262144" Content="{Binding [QualityVeryHigh], Source={x:Static starterNg:App.Loc}}" />
                                        </ComboBox>
                                    </ctl:SettingRow>
                                </StackPanel>
                            </ctl:SettingsSection>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>

                <!-- Key bindings bring their own scrolling and a star-sized middle
                     row, so they live beside the scroller, not inside it. -->
                <Grid x:Name="ControlsHost" RowDefinitions="Auto,*,Auto" Margin="8" IsVisible="False" />
                </Panel>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
